DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^product-demo/?$ product-demo.html [L,QSA]
  RewriteRule ^by-admin/?$ by-admin.html [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
